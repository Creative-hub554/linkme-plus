const __vite_ssr_export_default__ = "name: CI/CD\n\non:\n  push:\n    branches: [main, staging]\n  pull_request:\n    branches: [main]\n\n# A superseded PR run is wasted runner time and a second, stale result on the\n# same commit; cancel it. Pushes are left alone so a run that is about to deploy\n# is never cancelled halfway through.\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  lint:\n    name: Lint\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n      # `--max-warnings 0` (the `lint:ci` script) makes one warning fail the\n      # job. `npm run lint` stays permissive for local iteration, but CI must\n      # hold the zero-warning baseline the project worked to reach.\n      - run: npm run lint:ci\n      - run: npm run typecheck\n\n  test:\n    name: Test\n    runs-on: ubuntu-latest\n    # The proposal steps below read the base branch's coverage artifact\n    # (`actions: read`) and comment on the pull request (`pull-requests: write`).\n    # A fork PR gets a read-only token whatever is declared here, which is why\n    # those steps are advisory and the job summary carries the proposal for them.\n    permissions:\n      actions: read\n      contents: read\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n      # `test:coverage` is `vitest run --coverage && npm run coverage:floor &&\n      # npm run coverage:headroom`: the one-shot run is explicit rather than\n      # relying on Vitest noticing `CI=true`; the thresholds in\n      # `.freebuff/coverage-thresholds.mjs` hold each directory's aggregate; the\n      # floor script checks every file on its own against 52% lines/statements,\n      # and src/lib + src/utils on branches/functions too (a per-file floor\n      # Vitest's global `perFile` flag cannot express alongside the globs); and the\n      # headroom gate fails the job when the whole-tree aggregate clears its\n      # backstop by less than a point — a ratchet that tightens as the tree\n      # improves, without anyone editing a number.\n      - run: npm run test:coverage\n      # Publish the numbers whether the gate passed or failed — the point is the\n      # trajectory, and a run that just went red is exactly the one worth reading.\n      # `if: always()` is what makes that work after a failing step.\n      - name: Publish coverage summary\n        if: always()\n        run: npm run coverage:report\n      # The same run summary, the other gate: the collect baselines and soft\n      # threshold the reporter enforces on every collect. Two sources, deliberately.\n      # The recorded values come from `.freebuff/collect-budget-baselines.mjs` — the\n      # very file the gate imports — so the displayed number cannot disagree with the\n      # enforced one; and this run's measurements, the reporter's loose-gate verdicts,\n      # and the boundaries it judges against (how far past a recorded import cost is\n      # stale, how much headroom a band must lose to be stale, and the floor below\n      # which a band is not judged at all) come from the run report the suite leaves\n      # at `.freebuff/.collect-budget-run.json`. Printed together, both halves are\n      # legible on a *green* build, the one time nobody is looking at the gate. When\n      # no report is present — the script run on its own, or before any suite run in\n      # the job — the recorded columns still render and the row says so, rather than\n      # showing a blank as if it were zero.\n      - name: Publish collect-budget summary\n        if: always()\n        run: npm run collect:gates\n      # The rendered summary, posted where the reviewer already is: a pull request,\n      # updated in place. It adds nothing to measure — the body is the file the step\n      # above just wrote — and the marker the summary opens with is what identifies\n      # the previous comment, so a run edits that one rather than stacking a new\n      # comment every push. Skipped on forks, whose read-only token cannot comment;\n      # they still get the job summary and the artifact.\n      #\n      # The posting is `.freebuff/pr-comment.mjs`, shared with the two proposal comment\n      # steps below so the three cannot diverge: it refuses to hand `gh` a body that is\n      # missing, empty or blank — announcing the miss on the run page instead, the way the\n      # nightly job reports a report it never got — and it looks up the marked comment, then\n      # PATCHes it or POSTs the first one. Each step passes its own `--body`/`--marker` pair,\n      # held beside the writing script's own constant in `src/test/collect-budget.test.ts`.\n      - name: Comment the collect-budget summary on the pull request\n        id: comment-summary\n        if: >-\n          always() &&\n          github.event_name == 'pull_request' &&\n          github.event.pull_request.head.repo.full_name == github.repository\n        continue-on-error: true\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR: ${{ github.event.pull_request.number }}\n        run: |\n          node .freebuff/pr-comment.mjs \\\n            --body .freebuff/collect-gates.md \\\n            --marker '<!-- collect-budget-summary -->' \\\n            --label 'Collect-budget summary comment' \\\n            --producer 'Publish collect-budget summary'\n      # The gate machinery itself, pinned by content: the runner, every stage script, the\n      # two mutation checks and the lock they share, the redactor and the nightly report,\n      # the collect ratchet, the coverage gates, the two vitest configs, the compiler and\n      # linter config, and the workflows that run all of it. Each is compared to the hash\n      # recorded in `.freebuff/gate-hashes.mjs`, so a floor lowered by hand, a threshold\n      # moved in `coverage-thresholds.mjs`, an extra suite `exclude`, an `exclude` widened\n      # in `tsconfig.json`, a step deleted from `.github/workflows/ci.yml` or a stage with\n      # empty `inputs` fails here rather than passing every test it was written to pass.\n      # The step below proves the tests that hold a gate still notice a weakening; this\n      # proves the files they hold are the ones that were recorded. It is instant: it\n      # hashes files and reads one. Re-pin a deliberate change with `npm run gates:pin`, so\n      # the change arrives in the same diff a reviewer reads — and note that *this* file is\n      # one of the pinned ones, so an edit to the workflow itself is re-pinned the same way.\n      - name: Check the gate machinery is the pinned one\n        run: npm run gates:drift\n      # The coverage gates' own load-bearingness. `npm run test:coverage` above proves\n      # the numbers hold and the drift step proves the scripts are the recorded ones;\n      # this proves the tests that hold them still do — each coverage script is\n      # weakened in place, one at a time, and that script's own test file has to\n      # fail. It is affordable on every pull request (five single-file Vitest runs,\n      # not the minutes-long route sweep the nightly job owns through `npm run ci`,\n      # which reports this check the way it reports that sweep). It belongs here as\n      # well as at night because editing a gate script or one of its tests is\n      # exactly what moves the pin, and that edit arrives in a pull request.\n      - name: Check the coverage gates are load-bearing\n        run: npm run mutation:coverage\n      # The markdown summaries are also kept as an artifact, alongside the raw JSON\n      # the coverage report was built from, so any commit's coverage can be diffed\n      # against any other's: download two and run the report with `--compare`.\n      # The two record files ride along with the bodies they map: the poster files what\n      # it redacted beside the body it read, so a reviewer comparing the posted comment\n      # against this artifact needs the two together. Each exists only when its body had\n      # to be scrubbed, and a missing one is simply not uploaded.\n      - name: Upload coverage report\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: coverage-report\n          path: |\n            .coverage/coverage-report.md\n            .coverage/coverage-summary.json\n            .coverage/coverage-proposal.md\n            .coverage/coverage-proposal.redactions.json\n            .freebuff/collect-gates.md\n            .freebuff/collect-gates.redactions.json\n          retention-days: 30\n      # A pull request is where the ratchet should tighten: the change that raised\n      # coverage is the one holding the context to raise the threshold with it.\n      # Fetch the base branch's uploaded summary — the artifact two steps up — so\n      # the proposal can say what *this* change moved, and let\n      # `.freebuff/coverage-propose.mjs` turn that delta into numbers.\n      - name: Download the base branch's coverage artifact\n        if: github.event_name == 'pull_request'\n        continue-on-error: true\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          run_id=$(gh run list --repo \"$GITHUB_REPOSITORY\" --workflow ci.yml \\\n            --branch \"${{ github.base_ref }}\" --status success --limit 1 \\\n            --json databaseId --jq '.[0].databaseId')\n          if [ -z \"$run_id\" ] || [ \"$run_id\" = \"null\" ]; then\n            echo \"No successful '${{ github.base_ref }}' run has uploaded a coverage artifact yet.\"\n            exit 0\n          fi\n          gh run download \"$run_id\" --repo \"$GITHUB_REPOSITORY\" --name coverage-report --dir baseline\n      # Advisory, not a gate: it exits 0 whether or not there is anything to\n      # propose. `earned` tells the comment step whether this change is what made\n      # a raise possible — slack that was already there is listed but not\n      # commented on.\n      - id: propose\n        name: Propose threshold raises\n        if: always() && github.event_name == 'pull_request'\n        continue-on-error: true\n        run: |\n          baseline=$(find baseline -name coverage-summary.json 2>/dev/null | head -n1 || true)\n          if [ -n \"$baseline\" ]; then\n            npm run coverage:propose -- --baseline \"$baseline\" --baseline-label \"${{ github.base_ref }}\"\n          else\n            npm run coverage:propose\n          fi\n      # One comment per pull request, updated in place: the marker in the\n      # proposal is what identifies the previous one. Skipped on forks, whose\n      # token cannot comment — they still get the job summary and the artifact.\n      #\n      # `.freebuff/pr-comment.mjs` does the posting, as it does for the collect-budget\n      # summary above and the collect-budget proposal below, so all three share one\n      # guard: `earned` is the proposer's claim about what it found, not proof that the\n      # markdown is on disk, and the poster announces a body that is missing, empty or\n      # blank on the run page rather than handing a path that is not there to `gh` under\n      # `continue-on-error`. The `--body` and `--marker` it is given here are held beside\n      # the proposer's own declarations of both in `src/test/collect-budget.test.ts`.\n      - name: Comment the proposal on the pull request\n        id: comment-coverage\n        if: >-\n          steps.propose.outputs.earned == 'true' &&\n          github.event.pull_request.head.repo.full_name == github.repository\n        continue-on-error: true\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR: ${{ github.event.pull_request.number }}\n        run: |\n          node .freebuff/pr-comment.mjs \\\n            --body .coverage/coverage-proposal.md \\\n            --marker '<!-- coverage-threshold-proposal -->' \\\n            --label 'Coverage-proposal comment' \\\n            --producer 'Propose threshold raises'\n      # The verdict on the two comment steps above, and the reason they can stay\n      # `continue-on-error: true`: a comment that could not be posted must not stop the\n      # drift check or the coverage-mutation check between them and this step, and the\n      # price of that is a comment step failing while the job stays green — which is what\n      # this step converts. `.freebuff/pr-comment.mjs` exits non-zero whenever the comment\n      # is not on the pull request, `steps.<id>.outcome` is what the step did rather than\n      # what `continue-on-error` let the job make of it, and `.freebuff/comment-gate.mjs`\n      # holds the judgment: `failure` and `cancelled` fail the job and are named on the run\n      # page, while `skipped` passes because a step that was never run was never owed a\n      # comment — a fork's pull request, or one whose proposal was not earned.\n      - name: Fail when a comment this run owed was not posted\n        if: always()\n        run: |\n          node .freebuff/comment-gate.mjs \\\n            \"Collect-budget summary comment=${{ steps.comment-summary.outcome }}\" \\\n            \"Coverage-proposal comment=${{ steps.comment-coverage.outcome }}\"\n\n  # The collect-budget ratchet, the sibling of the coverage proposal above: a\n  # pull request is where it should tighten, because the change that sped\n  # collection up is the one holding the context to tighten the gate with it.\n  # This runs the recorder in *propose* mode — it measures the same way but writes\n  # a proposal instead of the checked-in `.freebuff/collect-budget-baselines.mjs`\n  # — and comments the baseline and soft-threshold drops it would make. Advisory:\n  # it exits 0 whether or not there is anything to propose, so it never fails a\n  # build, and the diff it proposes is applied by a person.\n  #\n  # The same runs are also the only place a *loose* baseline fails. One run is one\n  # noisy sample of a wall-clock quantity, so a single reading of a stale-high\n  # baseline is a warning everywhere else — the `test` job annotates it and moves\n  # on. Here the suite runs three times, and the step below fails only when every\n  # run agreed the recorded number is looser than the tree needs. That is why the\n  # job is not confined to pull requests: the default branch needs the confirmed\n  # version of the same judgment, and the fix still rides the proposal comment.\n  collect-propose:\n    name: Collect-budget proposal\n    runs-on: ubuntu-latest\n    # Three full suite runs, with room for a slow runner on top of them.\n    timeout-minutes: 30\n    permissions:\n      contents: read\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n      # Measuring collect time needs a real run — only the reporter can reach\n      # Vitest's `importDurations` — so this re-runs the suite rather than reading\n      # an artifact. It runs it three times: collect time is one noisy sample per\n      # run, so a proposed drop has to hold across all of them before it is posted\n      # and the reporter aggregates the runs by worst case. It writes\n      # `.freebuff/collect-budget-proposal.md` and an `earned` output for the comment\n      # step below — never `true` if any run left no sample.\n      - id: propose\n        name: Propose baseline and soft-threshold drops\n        continue-on-error: true\n        run: npm run collect:propose\n      # The gate half of the same session. The reporter left its run report after\n      # the last run — which recorded baselines held against the worst case every run\n      # measured — and this fails when the session was complete and they all agreed\n      # one is loose. It reads the report rather than re-measuring, and fails closed\n      # if the session never wrote one.\n      - name: Fail on a baseline every run agreed is loose\n        run: npm run collect:stale\n      # Kept even when nothing is proposed, so the artifact records that the check\n      # ran and any commit's proposal can be read back later. The redaction record, where\n      # the poster filed one, is kept with it for the same reason the coverage artifact\n      # keeps its own: it is what maps the posted comment back to the body here.\n      - name: Upload the collect-budget proposal\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: collect-budget-proposal\n          path: |\n            .freebuff/collect-budget-proposal.md\n            .freebuff/collect-budget-proposal.redactions.json\n          retention-days: 30\n      # One comment per pull request, updated in place: the marker in the proposal\n      # is what identifies the previous one. Skipped on forks, whose read-only token\n      # cannot comment — they still get the job summary and the artifact.\n      #\n      # `.freebuff/pr-comment.mjs` does the posting, as it does for the two comment\n      # steps in the test job, so all three share one guard. `earned` is the launcher's\n      # claim about what the session confirmed, not proof that the markdown survived it\n      # — the proposal is deleted at the start of every run and rewritten only by a run\n      # that has something to say — and the poster announces a body that is missing,\n      # empty or blank on the run page rather than handing a path that is not there to\n      # `gh` under `continue-on-error`. The `--body` and `--marker` here are held beside\n      # the launcher's own declaration of each in `src/test/collect-budget.test.ts`.\n      - name: Comment the proposal on the pull request\n        id: comment-proposal\n        if: >-\n          always() &&\n          steps.propose.outputs.earned == 'true' &&\n          github.event.pull_request.head.repo.full_name == github.repository\n        continue-on-error: true\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR: ${{ github.event.pull_request.number }}\n        run: |\n          node .freebuff/pr-comment.mjs \\\n            --body .freebuff/collect-budget-proposal.md \\\n            --marker '<!-- collect-budget-proposal -->' \\\n            --label 'Collect-budget proposal comment' \\\n            --producer 'Propose baseline and soft-threshold drops'\n      # The verdict on the comment step above, for the same reason the `test` job has one:\n      # the step is `continue-on-error` so that a failed comment cannot take the artifact\n      # upload with it, and this is what stops the job passing when the comment never\n      # arrived. Its wording and its `--label` are that step's, so the run page carries one\n      # name for the loss rather than two.\n      - name: Fail when a comment this run owed was not posted\n        if: always()\n        run: |\n          node .freebuff/comment-gate.mjs \\\n            \"Collect-budget proposal comment=${{ steps.comment-proposal.outcome }}\"\n\n  build:\n    name: Build\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n      - run: npm run build\n\n  deploy-staging:\n    name: Deploy to Staging\n    needs: [lint, test, build]\n    if: github.ref == 'refs/heads/staging'\n    runs-on: ubuntu-latest\n    environment: staging\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n      - run: npm run deploy:staging\n        env:\n          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}\n\n  deploy-production:\n    name: Deploy to Production\n    needs: [lint, test, build]\n    if: github.ref == 'refs/heads/main'\n    runs-on: ubuntu-latest\n    environment: production\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n      - run: npm run deploy:production\n        env:\n          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}\n"
