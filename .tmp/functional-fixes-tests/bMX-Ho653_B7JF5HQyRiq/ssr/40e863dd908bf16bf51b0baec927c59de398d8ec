const __vite_ssr_export_default__ = "name: Nightly\n\n# The full verification gate, on a schedule.\n#\n# The push and pull-request jobs in `ci.yml` split the pass into separate jobs,\n# and a local `npm run ci` stops at the first failing stage. Neither runs the\n# whole gate to completion against a clean checkout, so a regression that only a\n# *later* stage would notice — a mutant no test kills, a lint warning, a stale\n# runbook — can sit unnoticed until somebody happens to run the full pass. This\n# job closes that gap: it runs the gate end to end, at night, and publishes the\n# report.\n#\n# On a GitHub runner `CI=true`, so the runner turns `--keep-going` on by itself\n# and reports **every** failing stage at once instead of only the first.\n#\n# `--skip=preflight` drops the one stage that cannot hold here: it gates\n# registering a *local* preview and needs a live dev server on loopback and a\n# `.env.local` on disk, neither of which a hosted runner has. Running it would\n# fail every night for an environment it was never meant to judge. The run names\n# the exclusion in its report (`excluded`) and on its summary line, so the pass\n# is never mistaken for the whole gate.\non:\n  schedule:\n    # 02:17 UTC — off the hour, where the runner pool is least contended.\n    - cron: \"17 2 * * *\"\n  # Manual runs, for the morning after a suspicious commit.\n  workflow_dispatch:\n\n# A nightly run is long and fixed; if one is still going on the same ref, let it\n# finish rather than cancel it and start a second. Scoped per ref, like `ci.yml`,\n# so a manual dispatch on a branch cannot queue behind the scheduled default run.\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: false\n\npermissions:\n  contents: read\n\njobs:\n  full-gate:\n    name: Full CI gate\n    runs-on: ubuntu-latest\n    # The commit-back step below pushes the coverage row it recorded, so this\n    # job holds `contents: write` — scoped here, while the workflow's own\n    # `contents: read` stays the default for everything else.\n    permissions:\n      contents: write\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          cache: npm\n      - run: npm ci\n\n      # Run the whole gate with `--json`. The step's exit code is the gate's, so\n      # the job goes red on a regression; the report is written to disk either\n      # way, which is what the publish step below reads. `npm run --silent` keeps\n      # npm's own banner off stdout — without it the banner would be captured\n      # ahead of the JSON and break the parse — while stdout carries exactly the\n      # one report object and stderr (the runner's progress) goes to the log.\n      - name: Run the full CI gate\n        run: |\n          mkdir -p .ci\n          npm run --silent ci -- --json --skip=preflight > .ci/report.json 2> .ci/ci.log\n\n      # Publish even when the gate failed — a report nobody can read is the one\n      # failure that would make the schedule pointless. The Markdown summary goes\n      # to the run page; the annotations land on the files and lines they name;\n      # the raw report is kept as an artifact so a regression can be diffed\n      # against the previous night's.\n      - name: Publish the report\n        if: always()\n        run: |\n          if [ -s .ci/report.json ]; then\n            node .freebuff/nightly-report.mjs --report .ci/report.json --summary .ci/summary.md --annotations\n            cat .ci/summary.md >> \"$GITHUB_STEP_SUMMARY\"\n          else\n            echo \"## Nightly full CI gate — ❌ no report was written\" >> \"$GITHUB_STEP_SUMMARY\"\n            echo \"The gate never produced a JSON report — check the run log.\" >> \"$GITHUB_STEP_SUMMARY\"\n          fi\n\n      # The coverage trend, one committed row per run: the stamp the gate's\n      # report carries as `coverageStamp` is folded into the history file, so\n      # the rendered-links guard's readings accrue over time instead of living\n      # one run at a time. A red run records its row too — the stamp is a\n      # reading, not a verdict — and a suite that left none records nothing:\n      # the script exits 0 on that omission, the same omission the run page\n      # and the runbook make. Recorded even when the gate failed, for the same\n      # reason the report above is published `if: always()`.\n      - name: Record the coverage history row\n        if: always()\n        run: |\n          if [ -s .ci/report.json ]; then\n            node .freebuff/coverage-history.mjs --report .ci/report.json --file .freebuff/coverage-history.md\n          else\n            echo \"No report was written — no coverage row to record.\"\n          fi\n\n      # ...and the row lands where the next night can see it: committed and\n      # pushed back to the ref this run checked out, which is why the job\n      # holds `contents: write` above. The commit says `[skip ci]` so the push\n      # cannot wake the push-triggered jobs in `ci.yml` — a bot commit at\n      # night should record a reading, not start a deploy — and stages the pin\n      # manifest beside the history because that is the doctrine every\n      # workflow that commits is held to: whatever commits, commits the\n      # manifest with it (the rule `collect-budget.test.ts` states over the\n      # whole directory). A push a protected branch refuses turns the job red\n      # on purpose: a history that silently stops accruing is the failure this\n      # step exists to prevent.\n      - name: Commit the coverage history\n        if: always()\n        env:\n          NIGHTLY_DEPLOY_KEY: ${{ secrets.NIGHTLY_DEPLOY_KEY }}\n        run: |\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          git add .freebuff/coverage-history.md .freebuff/gate-hashes.mjs\n          if git diff --cached --quiet; then\n            echo \"The coverage history is unchanged — nothing to commit.\"\n          else\n            git commit -m \"chore(coverage): record the nightly rendered-links reading ($(date -u +%F)) [skip ci]\"\n            # The ruleset grants github-actions no bypass on a personal repository: the token's\n            # push is declined with \"Changes must be made through a pull request\". A deploy key\n            # *is* a listed bypass actor, so this one push authenticates as the key the secret\n            # holds instead of as the workflow token — the guard below says so plainly rather\n            # than letting an absent secret fail as an opaque ssh error at the far end.\n            if [ -z \"$NIGHTLY_DEPLOY_KEY\" ]; then\n              echo \"NIGHTLY_DEPLOY_KEY is not set — the commit-back cannot push master.\" >&2\n              exit 1\n            fi\n            mkdir -p \"$HOME/.ssh\" && chmod 700 \"$HOME/.ssh\"\n            printf '%s\\n' \"$NIGHTLY_DEPLOY_KEY\" > \"$HOME/.ssh/id_ed25519\"\n            chmod 600 \"$HOME/.ssh/id_ed25519\"\n            ssh-keyscan github.com >> \"$HOME/.ssh/known_hosts\"\n            git remote set-url origin \"git@github.com:${GITHUB_REPOSITORY}.git\"\n            git push origin \"HEAD:${GITHUB_REF_NAME}\"\n          fi\n\n      - name: Upload the report\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: nightly-ci-report\n          path: |\n            .ci/report.json\n            .ci/summary.md\n            .ci/ci.log\n            .freebuff/coverage-history.md\n          if-no-files-found: ignore\n          retention-days: 30\n"
