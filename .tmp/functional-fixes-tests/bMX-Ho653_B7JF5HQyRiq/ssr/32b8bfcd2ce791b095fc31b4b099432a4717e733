const __vite_ssr_export_default__ = "name: Collect-budget apply\n\n# The other half of the collect-budget ratchet's pull-request story.\n#\n# `ci.yml`'s `collect-propose` job measures a pull request and comments what the\n# change would tighten — the tracked-import baselines and the soft threshold —\n# plus a hidden payload of the exact values it measured. This workflow lets a\n# reviewer *act* on that comment: reply with the apply command and it opens a\n# follow-up pull request that writes those values into\n# `.freebuff/collect-budget-baselines.mjs`.\n#\n# Three things are deliberate:\n#\n#   - only a maintainer can trigger it. `issue_comment` fires for any comment on\n#     any issue and the whole payload arrives in the event, so the guard is an\n#     `author_association` check plus a bot exclusion: a contributor cannot move\n#     the gates by commenting. (Comments have no reply linkage in the REST\n#     payload, so the command is honoured on any comment on the pull request\n#     rather than only on the proposal thread.)\n#   - it applies the *payload*, never a fresh measurement. Re-running the suite\n#     on the runner would produce different numbers than the reviewer was shown,\n#     and reading the payload needs no dependencies at all — this job installs\n#     nothing.\n#   - it opens a pull request rather than pushing to the branch under review. The\n#     baselines describe the tree that earned them, so the follow-up is stacked on\n#     that branch's head: merging it lands the tightening together with the change\n#     that earned it, and merging the change first leaves a baselines-only diff.\n#     Opening against `main` instead would apply numbers measured on unmerged code\n#     and could leave `main` failing its own budget if the change were reverted.\n#\n# It also re-pins `.freebuff/gate-hashes.mjs`, and commits the two together. The baselines\n# are a pinned gate file — `npm run gates:drift` compares their content to the hash recorded\n# there — so a commit that rewrote them alone would land a tree whose pin no longer describes\n# it, and every branch carrying that commit would be red on drift until somebody re-pinned by\n# hand. The applier does the re-pin (targeted: that one file, and only if the rest of the pin\n# already matches the tree), and refuses rather than half-write — a refusal puts the baselines\n# back, reports `drift` and opens nothing.\n#\n# Then the alarm is run over the tree the commit is about to carry, and its verdict is the\n# job's. The applier's re-pin is what makes the commit consistent; running `gate-drift` anyway\n# is what makes that visible, because this is the one branch where nothing else will check it:\n# a pull request opened with `GITHUB_TOKEN` starts no workflows, so `ci.yml`'s drift stage\n# never runs on the commit that lands a re-pin. A check that disagrees stops the job before\n# the commit, and the reply says so in its own status rather than reporting `applied` over a\n# follow-up pull request that was never opened.\n#\n# Note a GitHub limitation this shares with any `GITHUB_TOKEN` automation: the pull\n# request it opens does not itself trigger `ci.yml` (token-created events do not\n# start workflows). The stacked pull request is one commit of recorded numbers, so\n# its own CI adds little, but the merge that lands it should still be a person's.\n#\n# Like the proposal job, nothing here is required for a merge: it is a convenience\n# for a review that has already been decided. The one thing it does that a person\n# could not do by hand is *lower* a gate, which is why applying it is a merge.\non:\n  issue_comment:\n    types: [created]\n\n# One approval at a time per pull request: a second command while the first is\n# still running would race the same file and the same branch.\nconcurrency:\n  group: collect-apply-${{ github.event.issue.number }}\n  cancel-in-progress: false\n\npermissions:\n  contents: write\n  pull-requests: write\n  issues: write\n\njobs:\n  apply:\n    name: Apply collect-budget proposal\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    if: >-\n      github.event.issue.pull_request &&\n      contains(github.event.comment.body, '/collect-apply') &&\n      github.event.comment.user.type != 'Bot' &&\n      contains(fromJSON('[\"OWNER\",\"MEMBER\",\"COLLABORATOR\"]'), github.event.comment.author_association)\n    steps:\n      # The event carries a comment, not a pull request, so everything else has to\n      # be fetched. `head.ref` is the branch the follow-up stacks on; `base.ref`\n      # is what the originating pull request targets. A fork's head branch is not\n      # ours to push to, so `same_repo` is what the apply step is gated on.\n      - name: Resolve the pull request\n        id: pr\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          pr=\"${{ github.event.issue.number }}\"\n          gh api \"repos/$GITHUB_REPOSITORY/pulls/$pr\" > \"$RUNNER_TEMP/pr.json\"\n          head=$(jq -r .head.ref \"$RUNNER_TEMP/pr.json\")\n          base=$(jq -r .base.ref \"$RUNNER_TEMP/pr.json\")\n          sha=$(jq -r .head.sha \"$RUNNER_TEMP/pr.json\")\n          fork=$(jq -r .head.repo.full_name \"$RUNNER_TEMP/pr.json\")\n          same_repo=false\n          if [ \"$fork\" = \"$GITHUB_REPOSITORY\" ]; then same_repo=true; fi\n          {\n            echo \"head=$head\"\n            echo \"base=$base\"\n            echo \"sha=$sha\"\n            echo \"same_repo=$same_repo\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"pull request #$pr: head=$head base=$base same_repo=$same_repo\"\n\n      - uses: actions/checkout@v4\n        with:\n          # The pull request's own head, not the default branch: the baselines the\n          # payload tightens are the ones on the tree that earned it.\n          ref: ${{ steps.pr.outputs.sha }}\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n\n      # No `npm ci`: the launcher reads the payload, merges it onto the committed\n      # baselines and writes the file with Node's own modules only.\n      - name: Apply the approved proposal\n        id: apply\n        if: steps.pr.outputs.same_repo == 'true'\n        env:\n          # Through the environment, never interpolated into the script: a comment\n          # is attacker-controlled text, and `${{ }}` inside `run:` would be a\n          # shell injection.\n          COMMENT_BODY: ${{ github.event.comment.body }}\n        run: |\n          set -euo pipefail\n          printf '%s' \"$COMMENT_BODY\" > \"$RUNNER_TEMP/proposal.md\"\n          node .freebuff/apply-collect-baselines.mjs --body-file \"$RUNNER_TEMP/proposal.md\"\n\n      # The alarm, over the exact tree the commit is about to carry — the same command\n      # `ci.yml`'s drift stage runs, and it needs no dependencies, like the step above. The\n      # applier has already re-pinned (and refuses rather than write a pin it cannot record),\n      # so this is not the thing that makes the commit consistent; it is the thing that puts\n      # the verdict in the run. Nothing else will: `GITHUB_TOKEN`-created pull requests do not\n      # start workflows, so the drift stage never sees the commit this job pushes.\n      - name: Check the pin describes the tree the commit will carry\n        id: verify\n        if: steps.apply.outputs.changed == 'true'\n        run: node .freebuff/gate-drift.mjs\n\n      # A fresh branch off the pull request's head, so the follow-up's diff is the\n      # baselines commit alone and its base is the branch that earned it. The run\n      # id keeps two approvals of different proposals on one pull request from\n      # fighting over the same branch.\n      - name: Open the follow-up pull request\n        if: steps.apply.outputs.changed == 'true' && steps.verify.outcome == 'success'\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR: ${{ github.event.issue.number }}\n          HEAD: ${{ steps.pr.outputs.head }}\n        run: |\n          set -euo pipefail\n          branch=\"collect-budget/apply-pr${PR}-${GITHUB_RUN_ID}\"\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"github-actions[bot]@users.noreply.github.com\"\n          git checkout -b \"$branch\"\n          # Both files the applier wrote: the baselines, and the gate manifest that pins\n          # them. Committing one without the other is the state the drift alarm refuses.\n          git add .freebuff/collect-budget-baselines.mjs .freebuff/gate-hashes.mjs\n          git commit -m \"chore: apply the collect-budget proposal from #${PR}\"\n          git push origin \"$branch\"\n          gh pr create \\\n            --base \"$HEAD\" \\\n            --head \"$branch\" \\\n            --title \"chore: apply the collect-budget proposal from #${PR}\" \\\n            --body-file .freebuff/collect-apply-pr.md\n\n      # Always answered, so a command never disappears into a log nobody reads.\n      # One comment per pull request, updated in place by its marker — and the\n      # marker deliberately does not contain the apply command, or the reply would\n      # arm the trigger again.\n      #\n      # The posting is `.freebuff/pr-comment.mjs`, the same one every comment step in\n      # `ci.yml` calls, so the marker lookup and the post-or-patch are one implementation\n      # rather than four. The reply is composed here rather than rendered to a file, so it\n      # goes through `--text` instead of `--body` — and that path carries the same guard: a\n      # blank reply is announced on the run page rather than posted as an empty comment.\n      #\n      # This step is deliberately **not** `continue-on-error`, and so needs no\n      # `.freebuff/comment-gate.mjs` step after it the way the three comment steps in\n      # `ci.yml` do: there is nothing after it to protect, so a poster that exits non-zero —\n      # a blank reply, or a `gh` that refused — fails this job directly. The gate exists\n      # exactly where `continue-on-error` would otherwise let a missing comment pass.\n      - name: Reply on the pull request\n        if: always()\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR: ${{ github.event.issue.number }}\n          SAME_REPO: ${{ steps.pr.outputs.same_repo }}\n          # The verification step's own outcome wins over the applier's: `applied` describes\n          # the files, and a check that disagreed with them means nothing was committed — so\n          # the reply has to say that, not that a follow-up pull request was opened.\n          STATUS: ${{ steps.verify.outcome == 'failure' && 'unverified' || steps.apply.outputs.status }}\n        run: |\n          set -euo pipefail\n          marker='<!-- collect-budget-apply -->'\n          if [ \"$SAME_REPO\" != \"true\" ]; then\n            summary=\"This pull request comes from a fork, so there is no branch here to open a follow-up against. Run \\`npm run collect:record\\` locally and commit the result instead.\"\n          else\n            case \"$STATUS\" in\n              applied)\n                summary=\"Applied the proposed narrowing in a follow-up pull request stacked on this branch. Review and merge it to adopt the tighter budgets.\" ;;\n              unchanged)\n                summary=\"Nothing to apply — the recorded baselines already sit at or below the proposed values.\" ;;\n              no-payload)\n                summary=\"This comment carries no collect-budget proposal payload, so there is nothing to apply. Use the command on the proposal comment itself.\" ;;\n              refused)\n                summary=\"Refused — the payload would have raised a recorded budget. A proposal may only tighten a gate, so nothing was written.\" ;;\n              drift)\n                summary=\"Refused — the values applied, but \\`.freebuff/gate-hashes.mjs\\` could not record the baselines they write, so nothing was committed and the baselines were put back. Run \\`npm run gates:pin\\` on that branch, look at why the pin did not match, and commit the two together.\" ;;\n              unverified)\n                summary=\"Refused — the values applied and were re-pinned, but \\`npm run gates:drift\\` then disagreed with the tree, so nothing was committed. That means the pin does not describe what the commit would have carried; run \\`npm run gates:drift\\` on that branch and look at what it reports.\" ;;\n              *)\n                summary=\"The approval could not be applied. See this workflow's log.\" ;;\n            esac\n          fi\n          body=$(printf '%s\\n\\n%s' \"$marker\" \"$summary\")\n          node .freebuff/pr-comment.mjs \\\n            --text \"$body\" \\\n            --marker \"$marker\" \\\n            --label 'Collect-budget apply reply' \\\n            --producer 'Reply on the pull request'\n"
