{
  "name": "linkme-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "vinext preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local src/lib/db/seed.ts",
    "notifications:check": "node --env-file-if-exists=.env.local .freebuff/notifications-check.mjs",
    "runbook:contents": "node .freebuff/build-contents.mjs",
    "runbook:check": "node .freebuff/build-contents.mjs --check",
    "preview:preflight": "node .freebuff/preview-preflight.mjs",
    "ci": "node .freebuff/ci.mjs",
    "mutation:guards": "node .freebuff/mutation-guards.mjs",
    "mutation:coverage": "node .freebuff/mutation-coverage.mjs",
    "mutation:preflight": "node .freebuff/mutation-preflight.mjs",
    "skill:index": "node .freebuff/build-skill-index.mjs",    "lint": "npm run stages:lint && eslint .",
    "lint:ci": "npm run stages:lint && eslint . --max-warnings 0",
    "lint:baseline": "node .freebuff/lint-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "types:worker": "wrangler types --include-runtime false",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage && npm run coverage:floor && npm run coverage:headroom",
    "coverage:floor": "node .freebuff/coverage-floor.mjs",
    "coverage:headroom": "node .freebuff/coverage-headroom.mjs",
    "coverage:propose": "node .freebuff/coverage-propose.mjs",
    "coverage:report": "node .freebuff/coverage-report.mjs",
    "gates:drift": "node .freebuff/gate-drift.mjs",
    "gates:status": "node .freebuff/ci.mjs --status",
    "stages": "node .freebuff/ci.mjs --stages",
    "stages:check": "node .freebuff/ci.mjs --stages=check",
    "stages:lint": "node .freebuff/ci.mjs --stages=check --commentary \"--watch-glob=docs/**/*.md,.github/workflows/*.y*ml\"",
    "stages:write": "node .freebuff/ci.mjs --stages=write",
    "gates:pin": "node .freebuff/gate-drift.mjs --write",
    "collect:record": "node .freebuff/record-collect-baselines.mjs",
    "collect:propose": "node .freebuff/propose-collect-baselines.mjs",
    "collect:stale": "node .freebuff/gate-collect-baselines.mjs",
    "collect:apply": "node .freebuff/apply-collect-baselines.mjs",
    "collect:gates": "node .freebuff/collect-gates.mjs",
    "clean": "rm -rf .vinext dist node_modules/.cache",
    "preview:local": "wrangler dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@cloudflare/vite-plugin": "^1.9.1",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.511.0",
    "next": "15.3.3",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "vinext": "^1.0.0-beta.10",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250710.0",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "jsdom": "^30.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.28.1"
  }
}
