{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The deployment target is a single configuration: this file is both what a
  // Cloudflare-side deploy consumes and what the Freebuff Sites Publish build
  // produces its worker metadata from. Sites provides neither a KV runtime nor
  // a Durable Object runtime, and a config the platform refused ("This Worker
  // uses KV namespaces, Durable Objects…") strands the whole publish path — so
  // the CACHE namespace and the WEBSOCKET_ROOM binding stay out on purpose,
  // with WHY absent: every consumer of them degrades by design. `/ws` answers
  // through the in-isolate hub (worker/index.ts) when no WEBSOCKET_ROOM
  // binding exists, presence is per-isolate, and nothing in `src/` reads
  // `env.CACHE`. The media cron (docs/GOOGLE-DRIVE-ARCHIVE.md) and the custom
  // routes remain exactly what a Cloudflare deploy uses; the Sites platform
  // applies its own origin and cron policy for what it hosts.
  "name": "linkme-plus",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "linkmeplus.com", "custom_domain": true },
    { "pattern": "www.linkmeplus.com", "custom_domain": true }
  ],
  // The media cron — eviction first, then the archive — hourly and off the
  // hour so it lands between traffic peaks. See docs/GOOGLE-DRIVE-ARCHIVE.md.
  "triggers": {
    "crons": ["17 * * *", "*/5 * * * *"]
  },
  // No `vars` here: the publish target refuses a Worker that sets Wrangler
  // vars, and nothing in the app reads `ENVIRONMENT` to want it back — a
  // deployment-level value belongs in the Sites variables panel, not inline.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "linkme-plus-uploads"
    }
  ],
  "observability": {
    "enabled": true
  }
}
