# The committed lock resolves wrangler@4.135.0 (via @cloudflare/vite-plugin),
# whose peerOptional @cloudflare/workers-types ^5 conflicts with the project's
# pinned ^4 (also required by drizzle-orm's >=4 peer). The tree is valid under
# legacy peer rules — which is how it was installed — so `npm ci` needs the same
# rule locally and on CI runners, or it fails with ERESOLVE before any test runs.
legacy-peer-deps=true
