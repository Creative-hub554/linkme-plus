[TEMPLATE]
DATABASE_URL="postgresql://user:password@localhost:5432/linkme_plus"
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
# Create at: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Telegram OAuth
# Create a bot via: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=""

# Phone Number Verification (Twilio)
# Sign up at: https://www.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="linkme-plus-uploads"
R2_PUBLIC_URL=""

# Cloudflare Workers
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare Stream
# The API token needs Stream Write permission. Enable MP4 downloads for the customer account.
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN="customer-xxxx.cloudflarestream.com"

# Email (Resend)
RESEND_API_KEY=""

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""
