[TEMPLATE]
DATABASE_URL="postgresql://user:password@localhost:5432/linkme_plus"

# Supabase Auth
# Project URL and anon (public) key: Supabase dashboard → Project Settings → API
# Enable Google/Facebook under Authentication → Sign In / Providers in the same dashboard.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Phone Number Verification (Twilio)
# Sign up at: https://www.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="linkme-plus-uploads"
R2_PUBLIC_URL=""

# Cloudflare Workers
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare Stream
# The API token needs Stream Write permission. Enable MP4 downloads for the customer account.
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN="customer-xxxx.cloudflarestream.com"

# Email (Resend)
RESEND_API_KEY=""

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""
